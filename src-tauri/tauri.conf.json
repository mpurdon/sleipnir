{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sleipnir",
  "version": "0.1.4",
  "identifier": "dev.purdonmoi.sleipnir",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "sleipnir",
        "width": 380,
        "height": 600,
        "minWidth": 340,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#090b0e",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
